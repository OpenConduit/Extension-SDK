{
  "name": "@openconduit/extension-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for building OpenConduit extensions — typed API bridge, manifest helpers, and React hooks.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "openconduit",
    "extension",
    "sdk",
    "electron",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenConduit/Extensions-Examples"
  }
}
